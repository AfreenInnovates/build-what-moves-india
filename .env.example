# Copy to .env and fill in. Never commit the filled version - .env* is gitignored.

# --- database -------------------------------------------------------------
# Neon connection string. Both names hold the same value: the code reads
# DATABASE_URL, NEON_CONNECTION_STRING is what neonctl writes.
# Prefer a region close to your users — from India, us-east-2 costs ~235ms a
# round trip and ap-south-1 costs ~30ms.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=verify-full&channel_binding=require
NEON_CONNECTION_STRING=

# --- Groq (assistant replies) ---------------------------------------------
GROQ_API_KEY=
# Measured on the real prompt: gpt-oss-120b 3.7s, gpt-oss-20b 1.3s.
GROQ_MODEL_REASONING=openai/gpt-oss-20b
GROQ_MODEL_FAST=openai/gpt-oss-20b
# The only image-capable model on Groq. Used by `npm run ocr:probe`.
GROQ_MODEL_VISION=qwen/qwen3.6-27b

# --- Sarvam (voice) -------------------------------------------------------
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
# bulbul:v2 is ~750ms, bulbul:v3 ~1100ms and sounds better. Speaker lists differ
# between the two model families.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_ASR_MODEL=saarika:v2.5
SARVAM_ASR_TRANSLATE_MODEL=saaras:v4
SARVAM_TEXT_MODEL=sarvam-105b

# --- app ------------------------------------------------------------------
GATE_SPEC_VERSION=2026.08.2
